# Alibaba Cloud Model Studio (DashScope) API key - Singapore / International region
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the base URL (default: https://dashscope-intl.aliyuncs.com)
# For workspace-specific domains use e.g. https://{WorkspaceId}.ap-southeast-1.maas.aliyuncs.com
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com

# Optional: override estimated price rates (USD)
# PRICE_VIDEO_480P_PER_SEC=0.05
# PRICE_VIDEO_720P_PER_SEC=0.10
# PRICE_VIDEO_1080P_PER_SEC=0.20
# PRICE_IMAGE_OUTPUT_1K=0.05
# PRICE_IMAGE_OUTPUT_2K=0.10
# PRICE_IMAGE_INPUT_1K=0.01
# PRICE_IMAGE_INPUT_2K=0.02

# OpenRouter API key (for google nano banana 2 image generation)
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override OpenRouter base URL / model / estimated price per image
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
# PRICE_OPENROUTER_IMAGE=0.134

# Optional: Director storyboard model (DashScope text model, default qwen3.8-flash)
# and its estimated price in USD per 1K tokens
# DIRECTOR_MODEL=qwen3.8-flash
# PRICE_DIRECTOR_PER_1K=0.002

# Optional: model used by the Video panel's "Rewrite" button (structures a
# prompt into a wan3.0 R2V request; cost uses PRICE_DIRECTOR_PER_1K)
# REWRITE_MODEL=qwen3.8-flash

# Optional: model used by the character auto-write button (default qwen3-vl-flash,
# a vision model that describes your uploaded reference images; falls back to
# qwen3.8-flash text-only if it cannot read them)
# APPEARANCE_MODEL=qwen3-vl-flash

# Video service provider for wan3.0: dashscope (default) | qwencloud
# Checked at app launch. When qwencloud is selected the Video panel exposes two
# modes: "text" (prompt + reference media) and "frame" (first + last frame).
# VIDEO_PROVIDER=dashscope

# QwenCloud credentials (only used when VIDEO_PROVIDER=qwencloud)
# Pay-as-you-go key base URL: https://dashscope-intl.aliyuncs.com
# Token Plan key base URL:    https://token-plan.ap-southeast-1.maas.aliyuncs.com
# QWENCLOUD_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# QWENCLOUD_BASE_URL=https://dashscope-intl.aliyuncs.com

# Optional: override estimated video cost (USD per output second)
# DashScope wan3.0-video (standard)
# PRICE_VIDEO_480P_PER_SEC=0.05
# PRICE_VIDEO_720P_PER_SEC=0.10
# PRICE_VIDEO_1080P_PER_SEC=0.20
# DashScope wan3.0-video-prime
# PRICE_VIDEO_PRIME_480P_PER_SEC=0.068
# PRICE_VIDEO_PRIME_720P_PER_SEC=0.14
# PRICE_VIDEO_PRIME_1080P_PER_SEC=0.28
# QwenCloud wan3.0-video (standard)
# PRICE_QC_VIDEO_480P_PER_SEC=0.05
# PRICE_QC_VIDEO_720P_PER_SEC=0.10
# PRICE_QC_VIDEO_1080P_PER_SEC=0.20
# QwenCloud wan3.0-video-prime
# PRICE_QC_VIDEO_PRIME_480P_PER_SEC=0.068
# PRICE_QC_VIDEO_PRIME_720P_PER_SEC=0.14
# PRICE_QC_VIDEO_PRIME_1080P_PER_SEC=0.28
